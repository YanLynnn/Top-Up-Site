# ---------- Toko ----------
SITE_NAME=TopUpin
# Nomor WhatsApp admin (format 628xxxx), tampil saat top up gagal
WHATSAPP_ADMIN=
# Domain final, tanpa slash di akhir. Kosongkan kalau mau otomatis dari Vercel
SITE_URL=
# Untung: harga jual = (modal x (1 + MARKUP_PERCENT/100) + FIXED_FEE), dibulatkan naik ke kelipatan ROUND_TO
MARKUP_PERCENT=6
FIXED_FEE=0
ROUND_TO=100

# ---------- Supabase (database order) ----------
SUPABASE_URL=https://xxxx.supabase.co
# Pakai service_role key, JANGAN anon key. Hanya dipakai di server.
SUPABASE_SERVICE_KEY=

# ---------- Duitku (payment gateway: DANA, QRIS) ----------
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# 1 = sandbox (uji coba), kosongkan/0 = produksi
DUITKU_SANDBOX=1

# ---------- Digiflazz (supplier top up) ----------
DIGIFLAZZ_USERNAME=
# Pakai Development Key dulu untuk uji, ganti Production Key saat live
DIGIFLAZZ_API_KEY=
# Secret yang kamu isi sendiri di menu Webhook Digiflazz
DIGIFLAZZ_WEBHOOK_SECRET=
# 1 = mode testing Digiflazz (tidak memotong saldo)
DIGIFLAZZ_TESTING=0

# ---------- Admin ----------
# Dipakai untuk /api/catalog?brands=1 (melihat nama brand di Digiflazz). Isi acak panjang.
ADMIN_KEY=
